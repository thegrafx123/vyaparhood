{
  "expo": {
    "name": "Vyaparhood",
    "slug": "vyaparhood",
    "scheme": "vyaparhood",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F9FAFF",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.vyaparhood.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We use this to show you what's happening in your own city from the moment you open the app — nearby members, local requests, real distances."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "in.vyaparhood.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "ACCESS_BACKGROUND_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#2F6FEA"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "We use this to show you what's happening in your own city from the moment you open the app — nearby members, local requests, real distances.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Vyaparhood needs your photos so you can add a profile picture.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "organization": "overviewfashion",
          "project": "react-native"
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-splash-screen",
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "color": "#2F6FEA"
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "0417cbac-4c11-46d7-a2c5-6bde4774e5db"
      }
    },
    "owner": "overviewfashion",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0417cbac-4c11-46d7-a2c5-6bde4774e5db"
    },
    "icon": "./assets/images/icon.png"
  }
}
