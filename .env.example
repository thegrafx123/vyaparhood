# Copy to .env.development (dev project) and .env.production (prod project).
# Supabase → Project Settings → API. The anon key is public by design.
# NEVER put the service_role key in any EXPO_PUBLIC_ variable.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Sentry → Project Settings → Client Keys (DSN). Leave empty to disable.
EXPO_PUBLIC_SENTRY_DSN=
# Optional: EXPO_PUBLIC_SENTRY_DEBUG=1 prints Sentry's own logs in Metro.
# Optional: EXPO_PUBLIC_SENTRY_TEST_MENU=1 shows the Sentry test buttons in Settings outside __DEV__.
# Source-map upload (EAS/production builds): put SENTRY_AUTH_TOKEN in .env.local or as an EAS secret, never EXPO_PUBLIC_.
# Edge functions read SENTRY_DSN from Supabase secrets:  npx supabase secrets set SENTRY_DSN=...
